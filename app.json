{
  "expo": {
    "name": "RabahDj-app-wrapper",
    "slug": "RabahDj-app-wrapper",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "rabahdjappwrapper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSCameraUsageDescription": "التطبيق يحتاج الكاميرا للبث المباشر",
        "NSMicrophoneUsageDescription": "التطبيق يحتاج المايك للتخاطب الصوتي والبث"
      },
      "bundleIdentifier": "com.rabahdj.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "BLUETOOTH_CONNECT",
        "BLUETOOTH_SCAN",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "WAKE_LOCK",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "WRITE_SETTINGS",
        "MODIFY_AUDIO_SETTINGS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_CAMERA",
        "QUERY_ALL_PACKAGES",
        "PACKAGE_USAGE_STATS",
        "SYSTEM_ALERT_WINDOW",
        "BIND_NOTIFICATION_LISTENER_SERVICE",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ],
      "package": "com.rabahdj.app",
      "usesCleartextTraffic": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#0b1220"
        }
      ],
      "expo-router",
      "expo-splash-screen",
      "expo-font",
      "expo-image",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-asset",
      "expo-video",
      "expo-brightness",
      [
        "expo-navigation-bar",
        {
          "enforceContrast": false
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "manifestPlaceholders": {
              "toolsReplaceAllowBackup": "android:allowBackup"
            }
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "يحتاج RabahDj إلى موقعك ليعمل تنبيه المناطق الذي فعّله وليّ أمرك."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "45a504bd-aecd-4565-ad97-dc5323906e1e"
      },
      "expo-navigation-bar": {
        "enforceContrast": false
      }
    },
    "owner": "rabahdfd1s-team"
  }
}
